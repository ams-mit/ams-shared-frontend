VITE_API_BASE_URL=http://localhost:8085/api/v1

# Central API gateway. identity-access-service (login, registration, users, roles) and
# resident-management-service (resident/owner/tenant/staff profiles) are called through it.
# When it can't be reached, or reports a service as unavailable (503 DEPENDENCY_UNAVAILABLE),
# the app falls back to offline demo data. Shared deployment:
#   VITE_GATEWAY_BASE_URL=https://ams-gateway.sasivarnasarma.me/api/v1
VITE_GATEWAY_BASE_URL=http://localhost:8080/api/v1

# Optional per-service overrides, e.g. to call one service directly while developing it:
# VITE_IDENTITY_API_BASE_URL=http://localhost:8080/api/v1
# VITE_RESIDENT_API_BASE_URL=http://localhost:8081/api/v1

# Group 2 services. Leave unset in dev to use the Vite proxies:
#   /lease-occupancy-api -> LEASE_SERVICE_URL    (default http://localhost:8084)
#   /property-unit-api   -> PROPERTY_SERVICE_URL (default http://localhost:8082)
# Point them at the Gateway once it routes the Group 2 APIs.
# VITE_LEASE_API_BASE_URL=http://localhost:8080/api/v1
# VITE_PROPERTY_API_BASE_URL=http://localhost:8080/api/v1
